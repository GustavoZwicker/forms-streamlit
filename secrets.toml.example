# Renomeie para secrets.toml (local) OU cole este conteúdo em
# Streamlit Cloud -> App -> Settings -> Secrets.
# NÃO faça commit do secrets.toml preenchido.

[gcp_service_account]
type = "service_account"
project_id = "seu-projeto"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\nLINHA1\nLINHA2\n-----END PRIVATE KEY-----\n"
client_email = "coletor@seu-projeto.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."

[planilha]
# ID da planilha: a parte longa da URL entre /d/ e /edit
spreadsheet_key = "1Abc...XYZ"

[admin]
# Painel de contagens: acesse o app com ?admin=ESTA_CHAVE
key = "troque-esta-chave"
